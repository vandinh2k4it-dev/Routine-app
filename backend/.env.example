DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
# Domain Vercel của bạn, nhiều domain cách nhau bằng dấu phẩy. Dùng * khi test.
CORS_ORIGIN=*
PORT=4000

# AI (quét phiếu InBody, PT ảo, lập lộ trình). Cần ít nhất MỘT khóa; có nhiều khóa thì thử lần lượt Gemini, GPT, Claude
# và tự chuyển sang nhà kế tiếp khi một nhà quá tải. Đổi thứ tự bằng AI_PROVIDER_ORDER=openai,gemini
# Gemini: lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Claude: lấy tại https://console.anthropic.com
ANTHROPIC_API_KEY=
# GPT: lấy tại https://platform.openai.com/api-keys (cần nạp tiền trước, khác với gói ChatGPT Plus)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
